# --- Database (Postgres) ---
# On Replit this is provisioned automatically. Locally, point at any Postgres instance.
DATABASE_URL=postgres://user:password@localhost:5432/auction_tracker

# --- Email (Resend) ---
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# The "from" address must be on a domain you've verified in Resend,
# or use onboarding@resend.dev for initial testing.
EMAIL_FROM="Auction Tracker <onboarding@resend.dev>"

# --- Web server ---
PORT=5000

# --- Scheduler ---
# Cron expression (server local time) for the daily scrape + digest.
# Default: every day at 08:00.
SCRAPE_CRON=0 8 * * *
# Set to "false" to disable the built-in scheduler (e.g. if you trigger scrapes externally).
SCHEDULER_ENABLED=true

# --- Scraping ---
# Playwright needs a Chromium binary. In this managed environment it is pre-installed:
PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers
# Max listings to pull per source per run (safety cap).
MAX_LISTINGS_PER_SOURCE=200
