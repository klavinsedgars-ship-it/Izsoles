{
  "name": "auction-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Daily Latvian real-estate auction & classifieds tracker with email digests (izsoles.ta.gov.lv, City24, SS.com)",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "node dist/server/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "scrape": "tsx src/cli.ts scrape",
    "scrape:source": "tsx src/cli.ts scrape --source",
    "digest": "tsx src/cli.ts digest",
    "test": "node --test --loader tsx dist-test-loader 2>/dev/null || tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "playwright": "^1.49.0",
    "resend": "^4.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.11",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
